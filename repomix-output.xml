    0px 8px 20px 0px hsl(0 0% 0% / 0.4), 0px 1px 2px -1px hsl(0 0% 0% / 0.4);
  --shadow:
    0px 8px 20px 0px hsl(0 0% 0% / 0.4), 0px 1px 2px -1px hsl(0 0% 0% / 0.4);
  --shadow-md:
    0px 8px 20px 0px hsl(0 0% 0% / 0.4), 0px 2px 4px -1px hsl(0 0% 0% / 0.4);
  --shadow-lg:
    0px 8px 20px 0px hsl(0 0% 0% / 0.4), 0px 4px 6px -1px hsl(0 0% 0% / 0.4);
  --shadow-xl:
    0px 8px 20px 0px hsl(0 0% 0% / 0.4), 0px 8px 10px -1px hsl(0 0% 0% / 0.4);
  --shadow-2xl: 0px 8px 20px 0px hsl(0 0% 0% / 1);

  /* 🫧 Liquid Glass Variables - Dark Mode */
  --glass-bg: oklch(20% 0.02 280 / 0.3);
  --glass-bg-strong: oklch(25% 0.03 280 / 0.45);
  --glass-bg-subtle: oklch(15% 0.01 280 / 0.2);
  --glass-border: oklch(100% 0 0 / 0.15);
  --glass-highlight: oklch(100% 0 0 / 0.2);
  --glass-shadow-color: oklch(0% 0 0 / 0.4);
  --glass-inner-glow: oklch(100% 0 0 / 0.05);
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);
  --color-sidebar: var(--sidebar);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);

  --font-sans: var(--font-sans);
  --font-mono: var(--font-mono);
  --font-serif: var(--font-serif);

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);

  --shadow-2xs: var(--shadow-2xs);
  --shadow-xs: var(--shadow-xs);
  --shadow-sm: var(--shadow-sm);
  --shadow: var(--shadow);
  --shadow-md: var(--shadow-md);
  --shadow-lg: var(--shadow-lg);
  --shadow-xl: var(--shadow-xl);
  --shadow-2xl: var(--shadow-2xl);

  --tracking-tighter: calc(var(--tracking-normal) - 0.05em);
  --tracking-tight: calc(var(--tracking-normal) - 0.025em);
  --tracking-normal: var(--tracking-normal);
  --tracking-wide: calc(var(--tracking-normal) + 0.025em);
  --tracking-wider: calc(var(--tracking-normal) + 0.05em);
  --tracking-widest: calc(var(--tracking-normal) + 0.1em);
}

@layer base {
  html {
    direction: rtl;
  }

  /* Hide the native cursor on mouse devices so the custom cursor takes over.
     Coarse-pointer devices (touch) keep the default cursor. */
  @media (pointer: fine) {
    html,
    html * {
      cursor: none !important;
    }
  }

  * {
    @apply border-border outline-ring/50;
  }

  body {
    @apply bg-background text-foreground;
    letter-spacing: var(--tracking-normal);
  }
}

@layer components {
  /* 🫧 Liquid Glass - Base */
  .liquid-glass {
    position: relative;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    -webkit-backdrop-filter: blur(var(--glass-blur))
      saturate(var(--glass-saturation));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow:
      0 8px 32px 0 var(--glass-shadow-color),
      0 2px 8px 0 oklch(0% 0 0 / 0.08),
      inset 0 1px 0 0 var(--glass-highlight),
      inset 0 -1px 0 0 oklch(100% 0 0 / 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    isolation: isolate;
  }

  /* ✨ Specular Highlight */
  .liquid-glass::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      oklch(100% 0 0 / 0.25) 0%,
      oklch(100% 0 0 / 0.05) 30%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* 🌈 Refraction Tint */
  .liquid-glass::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      ellipse at 50% 0%,
      oklch(80% 0.1 280 / 0.08) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 1;
    mix-blend-mode: overlay;
  }

  /* 🖱️ Hover Effect */
  .liquid-glass:hover {
    background: var(--glass-bg-strong);
    box-shadow:
      0 12px 40px 0 var(--glass-shadow-color),
      0 4px 12px 0 oklch(0% 0 0 / 0.1),
      inset 0 1px 0 0 var(--glass-highlight),
      inset 0 -1px 0 0 oklch(100% 0 0 / 0.12);
    transform: translateY(-1px);
  }

  /* 👆 Active/Pressed */
  .liquid-glass:active {
    transform: translateY(0);
    background: var(--glass-bg-strong);
  }

  /* 🪟 Strong Variant */
  .liquid-glass-strong {
    background: var(--glass-bg-strong);
    backdrop-filter: blur(30px) saturate(200%);
    -webkit-backdrop-filter: blur(30px) saturate(200%);
  }

  /* 💊 Pill Variant */
  .liquid-glass-pill {
    border-radius: 9999px;
    padding: 0.5rem 1.25rem;
  }

  /* 🎯 Subtle Variant */
  .liquid-glass-subtle {
    background: var(--glass-bg-subtle);
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
  }
}

/* 📱 Performance Optimization */
@media (prefers-reduced-motion: reduce) {
  .liquid-glass {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transition: none;
  }

  .liquid-glass:hover {
    transform: none;
  }
}

/* ──────────────────────────────────────────────────────
   🎬 Custom Keyframe Animations
────────────────────────────────────────────────────── */

/* Floating code tokens in hero background */
@keyframes code-float {
  0%,
  100% {
    transform: translateY(0px) rotate(0deg);
    opacity: 0.035;
  }
  33% {
    transform: translateY(-18px) rotate(0.5deg);
    opacity: 0.06;
  }
  66% {
    transform: translateY(-8px) rotate(-0.5deg);
    opacity: 0.04;
  }
}

/* Pulsing glow ring used on active/live badges */
@keyframes glow-pulse {
  0%,
  100% {
    box-shadow:
      0 0 0 0 oklch(0.62 0.18 287 / 0.4),
      0 0 20px oklch(0.62 0.18 287 / 0.2);
  }
  50% {
    box-shadow:
      0 0 0 6px oklch(0.62 0.18 287 / 0),
      0 0 40px oklch(0.62 0.18 287 / 0.35);
  }
}

/* Diagonal scan-line shimmer — used on hero title */
@keyframes shimmer {
  0% {
    background-position: -200% center;
  }
  100% {
    background-position: 200% center;
  }
}

/* ──────────────────────────────────────────────────────
   🛠️ Animation Utilities
────────────────────────────────────────────────────── */

.animate-code-float {
  animation: code-float var(--float-duration, 22s) ease-in-out infinite;
}

.animate-glow-pulse {
  animation: glow-pulse 2.5s ease-in-out infinite;
}

/* Hero dot-grid pattern — always uses a dark foreground tint */
.hero-dot-grid {
  background-image: radial-gradient(
    circle,
    oklch(100% 0 0 / 0.12) 1px,
    transparent 1px
  );
  background-size: 32px 32px;
}

/* Reduced motion: disable all custom keyframe animations */
@media (prefers-reduced-motion: reduce) {
  .animate-code-float,
  .animate-glow-pulse {
    animation: none;
  }
}
</file>

<file path="src/pages/index.astro">
---
import Layout from "../layouts/Layout.astro";
import { Header } from "@/components/layout/Header";
import { Footer } from "@/components/layout/Footer";
import { HeroSection } from "@/components/sections/HeroSection";
import { StatsBar } from "@/components/sections/StatsBar";
import { WhatIsICPCSection } from "@/components/sections/WhatIsICPCSection";
import { ContestFormatSection } from "@/components/sections/ContestFormatSection";
import { HighlightsSection } from "@/components/sections/HighlightsSection";
import { TimelineSection } from "@/components/sections/TimelineSection";
import { PrizesSection } from "@/components/sections/PrizesSection";
import { FAQSection } from "@/components/sections/FAQSection";
import { SponsorsSection } from "@/components/sections/SponsorsSection";
import { CustomCursor } from "@/components/animations/CustomCursor";
---

<Layout>
    <!-- Custom cursor: must load immediately so the OS cursor disappears on first frame -->
    <CustomCursor client:load />
    <Header client:load />

    <main>
        <!-- Hero: loads immediately — critical above-the-fold content -->
        <HeroSection client:load />

        <!--
      Narrative flow for first-time visitors:
        1. Numbers   → credibility       (StatsBar)
        2. Context   → what is ICPC      (WhatIsICPC)
        3. Format    → how BCPC works    (ContestFormat)
        4. Why join  → benefits          (Highlights)
        5. When      → the schedule      (Timeline)
        6. Reward    → prizes at stake   (Prizes)
        7. Answers   → common questions  (FAQ)
        8. Trust     → who backs it      (Sponsors)
    -->
        <StatsBar client:visible />
        <WhatIsICPCSection client:visible />
        <ContestFormatSection client:visible />
        <HighlightsSection client:visible />
        <TimelineSection client:visible />
        <!-- <PrizesSection client:visible /> -->
        <FAQSection client:visible />
        <!-- <SponsorsSection client:visible /> -->
    </main>

    <!-- Footer sits outside <main> — semantic landmark for screen readers -->
    <Footer client:visible />
</Layout>
</file>

<file path="src/layouts/Layout.astro">
---
import "../styles/global.css";
---

<!doctype html>
<html lang="fa" dir="rtl" class="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>BCPC</title>
        <link
            href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css"
            rel="stylesheet"
            type="text/css"
        />
    </head>
    <body>
        <slot />
    </body>
    <script>
        import Lenis from "lenis";

        const lenis = new Lenis({
            duration: 1.4,
            // Expo-out easing — fast start, smooth deceleration
            easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            orientation: "vertical",
            smoothWheel: true,
            wheelMultiplier: 0.9,
            touchMultiplier: 1.5,
        });

        // Lenis uses rAF internally; expose to window so other scripts can pause it
        (window as any).__lenis = lenis;

        function raf(time: number) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
    </script>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
    body {
        transition:
            background-color 0.3s ease,
            color 0.3s ease;
    }
    @media (prefers-reduced-motion: reduce) {
        body {
            transition: none;
        }
    }
</style>
