                  <AnimatedCounter
                    target={stat.value}
                    suffix={stat.suffix}
                    duration={1.6}
                  />
                </p>

                {/* Thin accent line */}
                <span className="block w-6 h-px bg-primary/50 rounded-full" />

                {/* Label */}
                <p className="text-xs md:text-sm text-white/40 font-medium leading-snug">
                  {stat.label}
                </p>
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>
  );
}
